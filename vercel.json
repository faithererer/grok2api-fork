{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.13",
        "installCommand": "pip install uv && uv sync --frozen"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/app/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "installCommand": "pip install uv && uv sync --frozen",
  "includeFiles": [
    "app/**/*",
    "config.defaults.toml",
    "pyproject.toml",
    "uv.lock"
  ]
}
